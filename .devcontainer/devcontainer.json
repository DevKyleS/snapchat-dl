{
	"name": "Snapchat DL Community",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"remoteUser": "vscode",
	"postCreateCommand": "python -m pip install -e \".[test]\" -r requirements_dev.txt",
	"customizations": {
		"vscode": {
			"settings": {
				"telemetry.telemetryLevel": "off"
			},
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-python.black-formatter"
			]
		}
	}
}
